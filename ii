    sort_order = VALUES(sort_order),
    active = 1;


-- ============================================================
-- 2. Reparare unicitate nomenclator
--
-- Initial:
-- UNIQUE(category_code, name)
--
-- Devine:
-- UNIQUE(category_code, name, item_code)
--
-- Necesar pentru:
-- Debian / 10
-- Debian / 11
-- Ubuntu / 18.04
-- Ubuntu / 20.04
-- etc.
-- ============================================================

SET @idx_cols = (
    SELECT GROUP_CONCAT(column_name ORDER BY seq_in_index)
    FROM information_schema.statistics
    WHERE table_schema = DATABASE()
      AND table_name = 'nomenclature_items'
      AND index_name = 'uq_nomenclature_category_name'
);

SET @sql = IF(
    @idx_cols = 'category_code,name',
    'ALTER TABLE nomenclature_items
       DROP INDEX uq_nomenclature_category_name,
       ADD UNIQUE KEY uq_nomenclature_category_name
           (category_code, name, item_code)',
    'SELECT ''Index deja corect'' AS info'
);

PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;


