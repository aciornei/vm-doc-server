# Opresti serviciul
systemctl stop keycloak

# Backup pentru JAR-ul vechi
mkdir -p /root/keycloak-themes-backup
cp /opt/keycloak/providers/*sts*.jar \
   /root/keycloak-themes-backup/ 2>/dev/null

# Elimini JAR-ul vechi al aceleiasi teme
rm -f /opt/keycloak/providers/keycloak-sts-themes-*.jar

# Copiezi noul JAR
cp keycloak-sts-themes-1.0.0-26.6.2.jar \
   /opt/keycloak/providers/

# Permisiuni
chown keycloak:keycloak \
   /opt/keycloak/providers/keycloak-sts-themes-1.0.0-26.6.2.jar


sudo -u keycloak /opt/keycloak/bin/kc.sh build
systemctl start keycloak
