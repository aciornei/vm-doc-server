SELECT
    u.username,
    u.email,
    ura.required_action
FROM user_entity u
JOIN user_required_action ura
    ON ura.user_id = u.id
JOIN realm r
    ON r.id = u.realm_id
WHERE r.name = 'AD'
ORDER BY u.username;

SELECT
    ura.required_action,
    COUNT(DISTINCT ura.user_id) AS total_utilizatori
FROM user_required_action ura
JOIN user_entity u ON u.id = ura.user_id
JOIN realm r ON r.id = u.realm_id
WHERE r.name = 'AD'
GROUP BY ura.required_action
ORDER BY total_utilizatori DESC;
