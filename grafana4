[auth.generic_oauth]

# Administrator global Grafana
role_attribute_path = contains(groups || `[]`, 'Grafana-Global-Admins') && 'GrafanaAdmin' || 'None'

allow_assign_grafana_admin = true

# Apartenenta la organizatia calculator
org_attribute_path = department == 'calculator' && [contains(groups || `[]`, 'Grafana-Calculator-Admins') && 'calculator-admin' || 'calculator-viewer'] || `[]`

# Roluri in organizatie
org_mapping = calculator-viewer:calculator:Viewer calculator-admin:calculator:Admin

skip_org_role_sync = false
